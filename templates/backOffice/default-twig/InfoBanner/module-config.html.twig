{# InfoBanner configuration, drawn on the module.configuration hook of the default-twig back office.

   The strings live in the module's own domain (I18n/*.php), not in a per-template one: a
   `<module>.bo.<template>` domain is keyed on the name of the back-office template directory, so
   moving or renaming that directory silently drops every translation. #}
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title mb-0">{{ 'Information banner'|trans({}, 'infobanner') }}</h3>
    </div>
    <div class="card-body">
        {{ form_start(form, {'action': path('infobanner.configuration.save'), 'method': 'POST'}) }}
            {{ form_errors(form) }}

            <div class="mb-3 col-md-8">
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
                <span class="form-text">
                    {{ 'Shown across the top of every front-office page. Leave it empty to draw no banner at all.'|trans({}, 'infobanner') }}
                </span>
            </div>

            <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, 'infobanner') }}</button>
        {{ form_end(form) }}
    </div>
</div>
