<?xml version="1.0" encoding="UTF-8" ?>

<!--
    TheliaKernel loads this file for every activated module without checking that it exists,
    so it stays even though it declares nothing.

    Nothing here is wired by hand any more: the configuration form is picked up through the
    `thelia.form` tag, the back-office hook through InfoBanner\Hook\Back\ConfigHook::getSubscribedHooks(),
    the front rendering through the `thelia.theme_hook` tag autoconfigured on ThemeHookInterface,
    and the controller route through its #[Route] attribute.
-->
<config xmlns="http://thelia.net/schema/dic/config"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://thelia.net/schema/dic/config http://thelia.net/schema/dic/config/thelia-1.0.xsd">
</config>
